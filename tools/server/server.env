# RUNEBOUND server settings. Plain KEY=VALUE: read by systemd (EnvironmentFile)
# and sourced by runebound-server.sh / run_godot.sh serve.

# UDP port the game server listens on. Passed through as an environment
# variable; the game reads it (M09).
RUNEBOUND_PORT=7777

# The dedicated server (M09): listens on RUNEBOUND_PORT and runs the zone of
# its own world save (user://runebound_server.json on the laptop).
RUNEBOUND_SCENE=res://scenes/dedicated_server.tscn
