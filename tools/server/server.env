# RUNEBOUND server settings. Plain KEY=VALUE: read by systemd (EnvironmentFile)
# and sourced by runebound-server.sh / run_godot.sh serve.

# M09b: friends come through Tailscale Funnel, which carries HTTPS/TCP only:
# the server speaks WebSocket on 127.0.0.1:RUNEBOUND_PORT and tailscaled
# forwards https://<laptop>.ts.net there (tools/server/setup-service.sh sets
# up the Funnel). "enet" = the old UDP server (LAN, Tailscale only).
RUNEBOUND_TRANSPORT=ws
RUNEBOUND_PORT=7780

# The dedicated server (M09): listens on RUNEBOUND_PORT and runs the zone of
# its own world save (user://runebound_server.json on the laptop).
RUNEBOUND_SCENE=res://scenes/dedicated_server.tscn

# M09b: the invite list (one code per friend, tools/server/invites.sh). Only
# the path lives here; the list itself never goes into the repo. A missing
# list means nobody can join until the first invite is added.
RUNEBOUND_INVITES=/etc/runebound/invites
