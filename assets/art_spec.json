		"environment_px_per_m": 32,
		"character_px_per_m": 64,
		"vfx_px_per_m": 32
	},
	"color_roles": {
		"threat": {
			"body": "#E8283C",
			"rim": "#FFF4F0",
			"rule": "enemy danger only: filled disc/lane + bright rim + visible fill progress, top render priority, fog-exempt"
		},
		"resonance": {
			"body": "#FFC34D",
			"hot": "#FFF0B8",
			"rule": "player class resource: armor rune glow + HUD bar; never used on enemies"
		},
		"player_accent": {
			"body": "#3CBEB4",
			"hot": "#9FF2E6",
			"rule": "player identity + targeting UI (Tab ring, frames)"
		},
		"experience": {
			"body": "#9FB4FF",
			"rule": "M07 experience: the thin HUD bar, level badge, XP toasts; periwinkle so it never reads as Resonance gold or the player teal"
		},
		"fire": {
			"edge": "#B8321C",
			"body": "#FF6A2A",
			"core": "#FFD27A",
			"rule": "Ember Lance, Burn, fire patches: turbulent, rising, short-lived"
		},
		"frost": {
			"edge": "#2C6FA8",
			"body": "#7FE0FF",
			"core": "#E8FBFF",
			"rule": "angular crystals, mist, fragmentation"
		},
		"lightning": {
			"edge": "#7C8CFF",
			"body": "#FFF6A0",
			"core": "#FFFFFF",
			"rule": "instant, branching, brief afterimage"
		},
		"physical": {
			"edge": "#8A8078",
			"body": "#E8E4DA",
			"core": "#FFFFFF",
			"rule": "directional sparks, dust, debris"
		},
		"void": {
			"edge": "#4A2A7A",
			"body": "#A060E8",
			"core": "#E8C8FF",
			"rule": "Spire/Duskweaver magic; enemy projectiles"
		},
		"env_emissive": {
			"body": "#A8441C",
			"rule": "ember cracks in the Highlands ground: tiny, dim (below glow threshold), slow flicker, never red, never disc-shaped"
		},
		"hearth": {
			"body": "#FFB866",
			"rule": "settlement windows and lanterns: small lit rectangles, dim (environment cap), never on the ground, never disc-shaped"
		},
		"rarity": {
			"common": "#E6E1D6",
			"magic": "#5A8CFF",
			"rare": "#F2D04B",
			"legendary": "#FF8A2A",
			"rule": "loot reads by vertical beam + label shape, not by hue alone"
		}
