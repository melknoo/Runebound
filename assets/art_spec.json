	"value_structure": {
		"rule": "luminance bands (0-100) so gameplay reads before hue: background 15-40, ground 25-40, walls/rocks 20-45, characters key planes 40-70, telegraphs/VFX 80-100",
		"min_enemy_vs_ground_delta": 15
	},
